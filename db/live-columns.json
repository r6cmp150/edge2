    },
    "signal_log": {
      "ret_1d_split_exclusive": "CHECK ((NOT ((ret_1d IS NOT NULL) AND ret_1d_split_in_window)))",
      "ret_3d_split_exclusive": "CHECK ((NOT ((ret_3d IS NOT NULL) AND ret_3d_split_in_window)))",
      "ret_5d_split_exclusive": "CHECK ((NOT ((ret_5d IS NOT NULL) AND ret_5d_split_in_window)))",
      "ret_close_split_exclusive": "CHECK ((NOT ((ret_close IS NOT NULL) AND ret_close_split_in_window)))",
      "signal_log_code_version_shape_chk": "CHECK (((code_version IS NULL) OR ((COALESCE(jsonb_typeof((code_version -> 'app'::text)), ''::text) = 'string'::text) AND (COALESCE(jsonb_typeof((code_version -> 'scoring'::text)), ''::text) = 'number'::text) AND ((NOT (code_version ? 'scoring_hash'::text)) OR (COALESCE(jsonb_typeof((code_version -> 'scoring_hash'::text)), ''::text) = 'string'::text)))))",
      "signal_log_engine_source_check": "CHECK ((engine_source = ANY (ARRAY['EDGE'::text, 'WARRIOR'::text])))",
      "signal_log_taken_resolution_check": "CHECK ((taken_resolution = ANY (ARRAY['unresolved'::text, 'taken-exact'::text, 'taken-by-fallback'::text, 'traded-against-engine'::text, 'not-taken-confirmed'::text])))"
    },
    "signal_snapshot_at_buy": {
      "signal_snapshot_at_buy_one_state_chk": "CHECK ((((snapshot IS NOT NULL) AND (absent_reason IS NULL) AND (jsonb_typeof(snapshot) = 'object'::text)) OR ((snapshot IS NULL) AND (absent_reason IS NOT NULL))))"
    },
    "trades_v2": {
      "trades_v2_code_version_shape_chk": "CHECK (((code_version IS NULL) OR ((COALESCE(jsonb_typeof((code_version -> 'app'::text)), ''::text) = 'string'::text) AND (COALESCE(jsonb_typeof((code_version -> 'scoring'::text)), ''::text) = 'number'::text) AND ((NOT (code_version ? 'scoring_hash'::text)) OR (COALESCE(jsonb_typeof((code_version -> 'scoring_hash'::text)), ''::text) = 'string'::text)))))",
      "trades_v2_engine_source_check": "CHECK ((engine_source = ANY (ARRAY['EDGE'::text, 'WARRIOR'::text])))",
      "trades_v2_execution_mode_chk": "CHECK (((execution_mode = ANY (ARRAY['live'::text, 'paper'::text, 'not_known'::text])) AND ((execution_mode = 'not_known'::text) OR (execution_mode_source IS NOT NULL)) AND ((execution_mode_source IS NULL) OR (execution_mode_source = 'recorded_at_trade'::text) OR (execution_mode_source ~ '^derived_from_robinhood_export_[0-9]{4}-[0-9]{2}-[0-9]{2}$'::text) OR (execution_mode_source ~ '^declared_by_roman_[0-9]{4}-[0-9]{2}-[0-9]{2}$'::text))))",
      "trades_v2_exit_rule_id_check": "CHECK (((exit_rule_id IS NULL) OR (exit_rule_id = ANY (ARRAY['edge.atr.multiday'::text, 'warrior.sameday.tightstop'::text]))))",
      "trades_v2_macro_path_check": "CHECK ((macro_path = ANY (ARRAY['pattern'::text, 'groq'::text, 'pattern_groq_failed'::text, 'unclassified'::text, 'not_fetched'::text, 'unknown'::text])))",
      "trades_v2_order_type_chk": "CHECK (((order_type IS NULL) OR (order_type = ANY (ARRAY['market'::text, 'limit'::text, 'stop'::text, 'stop_limit'::text, 'trailing_stop'::text]))))",
      "trades_v2_sale_code_version_shape_chk": "CHECK (((sale_code_version IS NULL) OR ((COALESCE(jsonb_typeof((sale_code_version -> 'app'::text)), ''::text) = 'string'::text) AND (COALESCE(jsonb_typeof((sale_code_version -> 'scoring'::text)), ''::text) = 'number'::text) AND ((NOT (sale_code_version ? 'scoring_hash'::text)) OR (COALESCE(jsonb_typeof((sale_code_version -> 'scoring_hash'::text)), ''::text) = 'string'::text)))))",
      "trades_v2_sell_filled_at_consistent": "CHECK ((((sell_filled_at_source IS NULL) AND (sell_filled_at IS NULL)) OR ((COALESCE(sell_filled_at_source, ''::text) = 'not_known'::text) AND (sell_filled_at IS NULL)) OR ((COALESCE(sell_filled_at_source, ''::text) = ANY (ARRAY['entered'::text, 'default'::text])) AND (sell_filled_at IS NOT NULL))))",
      "trades_v2_sell_filled_at_source_check": "CHECK (((sell_filled_at_source IS NULL) OR (sell_filled_at_source = ANY (ARRAY['entered'::text, 'default'::text, 'not_known'::text]))))",
      "trades_v2_sell_order_type_chk": "CHECK (((sell_order_type IS NULL) OR (sell_order_type = ANY (ARRAY['market'::text, 'limit'::text, 'stop'::text, 'stop_limit'::text, 'trailing_stop'::text]))))",
      "trades_v2_signal_before_sale_shape_chk": "CHECK (((signal_before_sale IS NULL) OR ((COALESCE((signal_before_sale ->> 'state'::text), ''::text) = 'PREDATES_SALE'::text) AND (COALESCE(jsonb_typeof((signal_before_sale -> 'scanned_at'::text)), ''::text) = 'string'::text)) OR ((COALESCE((signal_before_sale ->> 'state'::text), ''::text) = ANY (ARRAY['NOT_ESTABLISHED'::text, 'NOT_RECORDED'::text])) AND (COALESCE(jsonb_typeof((signal_before_sale -> 'reason'::text)), ''::text) = 'string'::text))))",
      "trades_v2_verdict_display_consistent": "CHECK ((((verdict_display_state IS NULL) AND (verdict_displayed_at_sale IS NULL)) OR ((COALESCE(verdict_display_state, ''::text) = 'NOT_DISPLAYED'::text) AND (verdict_displayed_at_sale IS NULL)) OR ((COALESCE(verdict_display_state, ''::text) ~~ 'CAPTURED_%'::text) AND (COALESCE(jsonb_typeof(verdict_displayed_at_sale), ''::text) = 'object'::text))))",
      "trades_v2_verdict_display_state_check": "CHECK (((verdict_display_state IS NULL) OR (verdict_display_state = ANY (ARRAY['CAPTURED_BEFORE_FILL'::text, 'CAPTURED_AFTER_FILL'::text, 'CAPTURED_FILL_UNKNOWN'::text, 'NOT_DISPLAYED'::text]))))",
      "trades_v2_verdict_provenance_chk": "CHECK (((verdict_provenance IS NULL) OR ((verdict_provenance = ANY (ARRAY['sale_moment'::text, 'mixed_moment'::text, 'not_recorded'::text])) AND ((verdict_provenance = 'not_recorded'::text) = (unified_recommendation_at_sale IS NULL)) AND ((verdict_provenance <> 'not_recorded'::text) OR (lock_in_profits_fired IS NULL)))))"
    }
  },
